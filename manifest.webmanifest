{
  "name": "StudyKori.app - HSC Study Tracker",
  "short_name": "StudyKori",
  "description": "Comprehensive study tracking for Bangladesh HSC students.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#F6F8F5",
  "theme_color": "#5B7DBE",
  "orientation": "portrait",
  "icons": [
    {
      "src": "/apple-touch-icon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}