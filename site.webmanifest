{
  "name": "StudyKori - HSC Study Tracker",
  "short_name": "StudyKori",
  "description": "Comprehensive study tracking for Bangladesh HSC students.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#F6F8F5",
  "theme_color": "#5B7DBE",
  "orientation": "portrait",
  "icons": [
    {
      "src": "/app-icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/app-icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/app-icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "/app-icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Login",
      "short_name": "Login",
      "url": "/app/dashboard",
      "icons": [{ "src": "/app-icon.svg", "sizes": "192x192" }]
    },
    {
      "name": "Start Focus",
      "short_name": "Focus",
      "url": "/app/tracker",
      "icons": [{ "src": "/app-icon.svg", "sizes": "192x192" }]
    }
  ]
}